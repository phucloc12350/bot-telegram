# =============================================
# Database - Vercel Postgres (tự inject khi link project)
# Khi dev local: copy 2 biến này từ Vercel dashboard
# =============================================
POSTGRES_PRISMA_URL="postgres://user:pass@host/db?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgres://user:pass@host/db?sslmode=require"

# =============================================
# NextAuth.js
# Sinh secret: openssl rand -base64 32
# =============================================
AUTH_SECRET="change-me-to-a-random-string"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# =============================================
# Admin mặc định (chỉ dùng cho seed lần đầu)
# =============================================
ADMIN_EMAIL="admin@local.dev"
ADMIN_PASSWORD="Admin@123"
ADMIN_NAME="Administrator"

# =============================================
# Telegram Bot
# Lấy token từ @BotFather
# WEBHOOK_SECRET tự sinh để verify Telegram gọi vào
# =============================================
TELEGRAM_BOT_TOKEN="8874294241:AAGsCkmrrkPIG_vlXZ1UxJ90oexoVQb8PbQ"
TELEGRAM_DEFAULT_CHAT_ID="-1004234743065"
TELEGRAM_WEBHOOK_SECRET="locdp_bot_channel"

# =============================================
# External API endpoints (giá vàng / giá xăng)
# =============================================
GOLD_API_URL="https://www.goldapi.io/api/XAU/USD"
GOLD_API_KEY="goldapi-d6f0a620fecba692ae8e80ce93099694-io"
FUEL_API_URL=""

# =============================================
# Cron - bảo vệ /api/cron/*
# Vercel sẽ auto gửi header Authorization: Bearer <CRON_SECRET>
# =============================================
CRON_SECRET="locdp_bot_channel"

# =============================================
# App
# =============================================
NEXT_PUBLIC_APP_NAME="Bot Telegram Dashboard"
